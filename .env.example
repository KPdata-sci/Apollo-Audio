# Copy this file to .env and adjust if needed. docker-compose reads .env automatically.

# --- Data lake ---
# "filesystem" (default) writes raw scrapes to ./data/lake on your machine, no
# extra service needed. Set to "s3" once you have a MinIO/S3 endpoint to point
# at (see README — MinIO isn't run by this compose file by default because its
# image may be blocked by a restricted Docker registry proxy).
APOLLO_LAKE_BACKEND=filesystem

# --- Postgres (data warehouse) ---
POSTGRES_USER=apollo
POSTGRES_PASSWORD=apollo
POSTGRES_DB=apollo

# --- Adminer (Postgres UI) is unauthenticated by default in this local stack ---

# --- Logging ---
# DEBUG / INFO / WARNING / ERROR. Written to stdout (docker compose logs) and
# to ./logs/apollo.log on your machine. DEBUG adds per-stage timing and
# internal detail (scroll iterations, DOM selector matches, hydration
# enrichment counts, warehouse row counts) — noisy but useful when
# troubleshooting a scrape that's behaving oddly.
APOLLO_LOG_LEVEL=INFO

# Once apollo.log exceeds this many bytes it's rotated: gzipped to
# apollo.log.1.gz, .2.gz, etc. Up to APOLLO_LOG_BACKUP_COUNT of these are
# kept; older ones are deleted.
APOLLO_LOG_MAX_BYTES=5000000
APOLLO_LOG_BACKUP_COUNT=10

# --- Optional: session cookies for pages that require login ---
# Leave empty for normal use. Some SoundCloud pages (e.g. a personal "Discover
# Weekly") only work when you're logged in as that specific account. This app
# never logs in for you and never asks for your password — if you want to try
# scraping a page like that, log into soundcloud.com yourself in a real
# browser, open DevTools -> Application/Storage -> Cookies -> soundcloud.com,
# and paste the cookie values here as "name1=value1; name2=value2". Untested
# by the person who built this (no SoundCloud account was available to verify
# against a real login wall) — treat it as experimental.
APOLLO_SOUNDCLOUD_COOKIES=
