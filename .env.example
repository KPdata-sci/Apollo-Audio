# Copy to .env (gitignored) and adjust. All values here are the same
# defaults docker-compose.yml already falls back to if a var is unset — this
# file exists so you have one place to see and override every knob.

# Pins the Compose project name so it doesn't get derived from the directory
# name. Compose otherwise names volumes/networks after the current folder —
# rename or move this project's directory and you'd silently get a brand-new
# empty postgres-data volume instead of reusing the existing one.
COMPOSE_PROJECT_NAME=apollo

## Postgres (data warehouse)
POSTGRES_USER=apollo
POSTGRES_PASSWORD=apollo
POSTGRES_DB=apollo

## Scraper API (scraper/app/settings.py, all prefixed APOLLO_ there)
APOLLO_LAKE_BACKEND=filesystem
APOLLO_LOG_LEVEL=INFO
APOLLO_LOG_MAX_BYTES=5000000
APOLLO_LOG_BACKUP_COUNT=10

# Gates POST /scrape and POST /api/discover-playlists behind an X-API-Key
# header. Leave empty for local dev (matches this app's behavior before this
# setting existed). Set this to a long random value before the API is
# reachable from outside your own machine — generate one with, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APOLLO_API_KEY=

# Comma-separated list of origins allowed to call the API cross-origin, or
# "*". Only matters once the frontend/ container runs on a different origin
# than the api container (docker-compose's default setup keeps both on
# localhost, so "*" is fine there).
APOLLO_CORS_ORIGINS=*

# Comma-separated soundcloud.com playlist/profile URLs to auto-ingest on a
# schedule (scraper/app/ingest.py) — empty (off) by default; e.g. pick some
# from the playlists.py catalog. Not run automatically by docker-compose;
# trigger it yourself with `docker compose run --rm api python -m app.ingest`.
# In Kubernetes this runs on a timer via infra/terraform-k8s/ingest-cronjob.tf.
APOLLO_INGEST_URLS=

# Optional. For pages that require being logged in as a specific SoundCloud
# account (e.g. a personal Discover Weekly) — anonymous playlist/set/profile
# pages don't need this. Get it from your own browser: log into SoundCloud,
# open DevTools -> Application/Storage -> Cookies -> https://soundcloud.com,
# copy the whole cookie header value. This project never asks for or stores
# your SoundCloud password, and this path is untested (no test account was
# available while building it) — see README "Pages that require login".
APOLLO_SOUNDCLOUD_COOKIES=

## Frontend (frontend/, decoupled from the API — see docs/HOSTING.md)
# Leave both empty/default for local docker-compose use — the page derives
# the API's address at runtime from whatever host/IP loaded it (so it works
# correctly whether you're browsing via localhost, a LAN IP, or a Tailscale
# IP, without picking one — see frontend/Dockerfile). Only set
# APOLLO_API_BASE_URL if you need to override with one fixed address (e.g.
# reaching the API through a reverse proxy on a different port scheme).
APOLLO_API_PORT=8000
APOLLO_API_BASE_URL=
